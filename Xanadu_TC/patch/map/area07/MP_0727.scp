}

RES("WIN")
{
	CHECK_GAME_FLAG(715)
	ON_JUMP next

		STOP_PC(0)
		WAIT(60)
		SE("SE_STOPPER")
		CINEMA_ON(0)
		FOCUS_CHR("stop")
		SWITCH_ON("stop")
		WAIT(90)
		CINEMA_OFF(0)

	GAME_FLAG_ON(715)

	// ƒJƒMÝ’è
	CHECK_GAME_FLAG(1711)
	ON_SKIP(2)
	KAGI("d1711",1)
	SKIP(1)
	INIT_SWITCH_ON("d1711")

next:

}


