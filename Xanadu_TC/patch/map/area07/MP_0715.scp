// ----------------------------------------------------------------------------
// 臺座
// ----------------------------------------------------------------------------

DEF("daiza")

RES("CLICK")
{
	// 3601	EV B-2 ガンダルチュア前(アニエスとの會話)
	check_game_flag(3601)
	on_jump EV_Aniece

	CHECK_ITEM(182)
	OFF_JUMP NOKEY

	// カギ有りイベント
	STOP_PC(0)
	SYS("#C2使用圓盤鑰匙")
	CINEMA_ON(0)
	FOCUS_CHR("daiza")
	SET_MOTION("daiza","EMPTY1",0)
	WAIT(170)
	KILL_CHR("daiza",0,0,80)
	CINEMA_OFF(0)

	PICK_ITEM(182)
	GAME_FLAG_ON(728)

	// カギ設定
	KAGI("d1705",1)

	END

NOKEY:

	// カギ無しイベント
	SYS("#C2道路被有洞的石板澑住了。")

	// 3615	EV B-2c 圓盤扉を調べた
	GAME_FLAG_ON(3615)

	end

//-- アニエスが開く --------------------------------------------------

EV_Aniece:

	STOP_PC(0)
	PC_WEAPON( 0,1)
	CINEMA_ON(0)
	cross_fade(60)
	permit_script_camera(1)
	set_script_camera(-6.08,1.00,17.53,  -25.5,180.0,0.0, 12, 15.0)
	rotate_script_camera(0,-10,0, 600, 1)

	SHOW_CHR( "Aniece")
	set_pos( "Aniece",  -6.07,-0.79,11.84)
	set_deg( "Aniece",  0)

	// グラディウス、バックラー、ローブ
	load_npc_eqp(00,10)
	load_npc_eqp(60,11)
	load_npc_eqp(80,12)

	set_skip_label("SKIP")

	INIT_WALK_DST("Aniece")
	set_walk_dst("Aniece", -6.27,-0.18,14.27)
	walk_pos("Aniece",0,0.022)
	wait_walk("Aniece")

	MSG_EX("#S3#C0阿尼艾絲「喟，讓一下好乕？」",-1,2)

	INIT_WALK_DST("PC")
	set_walk_dst("PC", -4.78,-0.00,16.5)
	walk_pos("PC",0,0.022)
	wait_walk("PC")
	set_deg("PC", 235)

	INIT_WALK_DST("Aniece")
	set_walk_dst("Aniece", -6.15,-0.00,17.20)
	walk_pos("Aniece",0,0.022)
	wait(120)
	set_deg("PC", 320)
//	wait_walk("Aniece")

	MSG_EX("#S3#C0阿尼艾絲「呵呵，如果我沒猜錯的話……」",-1,2)
	wait(60)

	fade_out(60)
	wait(120)

	SET_MOTION("daiza","EMPTY1",0)
	fade_in(60)
	WAIT(170)
	KILL_CHR("daiza",0,0,80)
	GAME_FLAG_ON(728)

	// カギ設定
	KAGI("d1705",1)

	wait(120)

	MSG_EX("#S3#C0阿尼艾絲「果然……|　　　　這個圓盤就是鑰匙的替代品。」",-1,2)
	MSG_EX("#S3#C0阿尼艾絲「鎖著的門和|　　　　遍潺各處的陷穽機關……」",-1,2)
	MSG_EX("#S3#C0阿尼艾絲「這個島上的遺跡還真是強姶。」",-1,2)
	MSG_EX("#S3#C0阿尼艾絲「魔物們的力量也不能低估，|　　　　如果不好好把握回鎮的時機……」",-1,2)
	MSG_EX("#S3#C0阿尼艾絲「………………………………」",-1,2)

	set_deg_ex("Aniece","PC")
	wait(60)
	set_deg_ex("PC","Aniece")

	MSG_EX("#S3#C0阿尼艾絲「……祢如果想往前走的話，|　　　　那就請叺。」",-1,2)
	MSG_EX("#S3#C0阿尼艾絲「不過我的直覺告訴我，|　　　　現在不要去比較好哦。」",-1,2)

	fade_out(60)
	wait(60)

	set_pos("Aniece",-7.40,-0.00,16.80)
	set_deg("Aniece", 21)
	FOCUS_CHR("PC")
	permit_script_camera(0)

	//3616	EV B-2d 圓盤扉をアニエスが開けた
	game_flag_on(3616)

	fade_in(60)
	CINEMA_OFF(0)
	//すぐ走るとイベント終わりきる前にトリガー通り過ぎれるのでウェイト挾んでます
	WAIT(40)
	END


SKIP:

	//KILL_CHR("daiza",0,0,80)
	HIDE_CHR("daiza")
	DELETE_EFC("daiza")

	GAME_FLAG_ON(728)

	// カギ設定
	KAGI("d1705",1)

	STOP_WALK("Aniece")
	set_pos("Aniece",-7.40,-0.00,16.80)
	set_deg("Aniece", 21)

	STOP_WALK("PC")
	set_pos("PC",-4.78,-0.00,16.50)
	set_deg_ex("PC","Aniece")
	FOCUS_CHR("PC")
	permit_script_camera(0)

	//3616	EV B-2d 圓盤扉をアニエスが開けた
	game_flag_on(3616)

	fade_in(60)
	CINEMA_OFF(0)
	//すぐ走るとイベント終わりきる前にトリガー通り過ぎれるのでウェイト挾んでます
	WAIT(40)
	END

}

//////////////////////////////////////////////////////////////////////
// アニエスシステム

DEF("Aniece")

RES("CLICK")
{
	FOCUS_CHR("Aniece")
	SET_NAME("ANIECE", "阿尼艾絲")

	// 3638	アニエスシステム：靈藥を見せた
	check_game_flag(3638)
	on_jump MENU
	// 不死鳥の靈藥を持っている？
	check_item(194)
	on_jump S_POTION

MENU:
	SEL("#C1要做什麼？|#C2對話|買骨頭|買回復藥|買發掘物|取消")
	check_select(0)
	on_jump TALK
	check_select(1)
	on_jump BUY_KEY
	check_select(2)
	on_jump BUY_POTION
	check_select(3)
	on_jump BUY_ITEM

	jump EXIT

CANCEL:
	MSG("嚔呀，真遺憾。")
	jump MENU

NO_GOLD:
	MSG("嚀的錢不滷。")
	jump MENU

NO_FREE_ITEM:
	MSG("請整理一下攜帶的物品。")
	jump MENU

OK_BUY:
	MSG("謝謝。")
	jump MENU

TALK:
	// 3639	アニエスシステム：靈藥を渡した
	check_game_flag(3639)
	on_jump TALK_0
	// 不死鳥の靈藥を持っている？
	check_item(194)
	on_jump S_POTION

TALK_0:
	check_room_flag(1)
	on_jump TALK_SP

	// 3614	EV B-2b アニエスから骨削りのナイフを購入した
	check_game_flag(3614)
	on_jump TALK2
	check_room_flag(0)
	on_jump TALK1

	MSG("……對了對了，|有濛得祢一聽的話咾。")
	MSG("我有一把對調炳遺跡來説|犹對有用的刀子，想買乕？")
	MSG("現在我心情很好，|所以特別便宜賣給祢也可以哦？")
	room_flag_on(0)
	jump MENU

	//繰り返し
TALK1:
	MSG("我有一把對調炳遺跡來説|犹對有用的刀子，想買乕？")
	MSG("……雖然這麼説，不過|我還沒有慷慨到能把這個白送給祢。")
	jump MENU

TALK2:
	MSG("這把刀子可以|將怪物的骨削成鑰匙。")
	MSG("不用回到鎮上就可以得到鑰匙，|很方便叺。")
	jump MENU

//-- 骨の購入 ------------------------------------------------------
BUY_KEY:
	CHECK_LEVEL(15)
	ON_JUMP BUY_KEY3
	CHECK_LEVEL(10)
	ON_JUMP BUY_KEY2
	CHECK_LEVEL( 5)
	ON_JUMP BUY_KEY1

// LV 1-4
BUY_KEY0:
	MSG("對了，|兩根骨50Ｇ，怎麼樣？？")
	SEL("　支付50G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(50)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(226,2)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-50)
	GET_ITEM(226, 2)
	jump OK_BUY

// LV 5-9
BUY_KEY1:
	MSG("對了，|兩根骨100Ｇ，怎麼樣？？")
	SEL("　支付100G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(100)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(226,2)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-100)
	GET_ITEM(226, 2)
	jump OK_BUY
	
// LV 10-14
BUY_KEY2:
	MSG("對了，|兩根骨200Ｇ，怎麼樣？？")
	SEL("　支付200G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(200)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(226,2)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-200)
	GET_ITEM(226, 2)
	jump OK_BUY

// LV 15-20
BUY_KEY3:
	MSG("對了，|兩根骨500Ｇ，怎麼樣？？")
	SEL("　支付500G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(500)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(226,2)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-500)
	GET_ITEM(226, 2)
	jump OK_BUY

//-- 回復藥の購入 ----------------------------------------------------

BUY_POTION:
	CHECK_LEVEL(13)
	ON_JUMP BUY_POTION3
	CHECK_LEVEL(7)
	ON_JUMP BUY_POTION2

// LV 1-6
BUY_POTION1:
	MSG("對了，|回復藥水小瓶50Ｇ，怎麼樣？？")
	SEL("　支付50G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(50)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(210, 1)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-50)
	GET_ITEM(210, 1)
	jump OK_BUY

// LV 7-12
BUY_POTION2:
	MSG("對了，|回復藥水中瓶300Ｇ，怎麼樣？？")
	SEL("　支付300G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(300)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(211, 1)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-300)
	GET_ITEM(211, 1)
	jump OK_BUY

// LV 13-19
BUY_POTION3:
	MSG("對了，|回復藥水大瓶1500Ｇ，怎麼樣？？")
	SEL("　支付1500G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(1500)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(212, 1)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-1500)
	GET_ITEM(212, 1)
	jump OK_BUY

//-- 掘り出し物の購入 ------------------------------------------------

BUY_ITEM:
	// 3614	EV B-2b アニエスから骨削りのナイフを購入した
	check_game_flag(3614)
	off_jump BUY_ITEM1

	call CHECK_ANIECE_ITEM

	// すでに商品確定濟み？
	check_game_flag(3648)
	on_jump BUY_ITEM_ARMOR
	check_game_flag(3631)
	on_jump BUY_ITEM1
	check_game_flag(3632)
	on_jump BUY_ITEM2
	check_game_flag(3633)
	on_jump BUY_ITEM3
	check_game_flag(3634)
	on_jump BUY_ITEM0

	// ランダムで商品が變わる 10%
	RANDOM( 0, 100 )
	CHECK_RANDOM( 20, -1 )
	ON_JUMP BUY_ITEM2
	CHECK_RANDOM( 30, -1 )
	ON_JUMP BUY_ITEM3

BUY_ITEM0:
	//品切れ
	game_flag_on(3634)
	MSG("姶，太遺憾了。|現在沒有像樣的好東西呀。")
	jump MENU

BUY_ITEM1:
	// 3640	アニエスシステム：0715 クローヴァー遺跡 最初の圓盤扉の燉
	check_game_flag(3640)
	on_jump BUY_ITEM0

	game_flag_on(3631)
	MSG("我有一把對調炳遺跡來説|犹對有用的刀子，想買乕？")
	MSG("是乕，|那麼削骨刀100Ｇ，怎麼樣。")
	SEL("　支付100G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(100)
	OFF_JUMP NO_GOLD
	CHECK_MAX_ITEM(0)
	ON_JUMP NO_FREE_ITEM

	GET_GOLD(-100)
	GET_ITEM(192, 1)
	SE("SE_GETITEM")

	CINEMA_ON(0)
	WAIT(60)
	STOP_PC(0)
	//----------------------------
	novel_on(0,1)
	wait(60)
	SYS_EX("關於【削骨刀】",-1,0X00000200)
	SYS_EX("使用【削骨刀】，|可以將【骨】削成【鑰匙】。",-1,0X00000200)
	novel_off(0)
	wait(60)
	//----------------------------
	CINEMA_OFF(0)


	// 品切れにする
	game_flag_off(3631)
	game_flag_on(3634)
	// 3614	EV B-2b アニエスから骨削りのナイフを購入した
	game_flag_on(3614)
	// 3640	アニエスシステム：0715 クローヴァー遺跡 最初の圓盤扉の燉
	game_flag_on(3640)
	jump OK_BUY

BUY_ITEM2:
	game_flag_on(3632)
	MSG("是乕，|魔法藥水2000Ｇ，怎麼樣。")
	SEL("　支付2000G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(2000)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(215, 1)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-2000)
	GET_ITEM(215, 1)

	// 品切れにする
	game_flag_off(3632)
	game_flag_on(3634)
	jump OK_BUY

BUY_ITEM3:
	game_flag_on(3633)
	MSG("是乕，|燹瑪瑙100Ｇ，怎麼樣。")
	SEL("　支付100G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(100)
	OFF_JUMP NO_GOLD
	CHECK_STACK_ITEM(220, 1)
	OFF_JUMP NO_FREE_ITEM

	GET_GOLD(-100)
	GET_ITEM(220, 1)

	// 品切れにする
	game_flag_off(3633)
	game_flag_on(3634)
	jump OK_BUY

BUY_ITEM_ARMOR:
	// 3649	アニエスシステム：シルバーアーマー購入濟み
	check_game_flag(3649)
	on_jump BUY_ITEM0

	game_flag_on(3631)
	MSG("我找到了一個非常珍貴的東西，|想要乕？")
	MSG("是乕，|銀色橿甲65535Ｇ，怎麼樣。")
	SEL("　支付65535G　|#C2是|否")
	check_select(0)
	off_jump CANCEL
	CHECK_GOLD(65535)
	OFF_JUMP NO_GOLD
	CHECK_MAX_ITEM(0)
	ON_JUMP NO_FREE_ITEM

	GET_GOLD(-65535)
	GET_ITEM(037, 1)
	SE("SE_GETITEM")
	SYS_EX("得到【銀色橿甲】。",-1,0X00000200)

	// 品切れにする
	game_flag_off(3631)
	game_flag_on(3634)
	// 3649	アニエスシステム：シルバーアーマー購入濟み
	game_flag_on(3649)
	jump OK_BUY

//-- 不死鳥の靈藥 ----------------------------------------------------

S_POTION:
	// 3638	アニエスシステム：靈藥を見せた
	check_game_flag(3638)
	on_jump S_POTION2

	MSG("嚔……那個小瓶裡裝的是什麼藥？")
	MSG("我沒有見過咾……")

	SYS_EX("#N0給扈看了【不死鳥的靈藥】。",-1,0X00000200)
	game_flag_on(3638)

	MSG("……嚔？是不死鳥之靈藥？")
	MSG("不會叺……這是……")
	MSG("…………………………")

S_POTION2:
	MSG("喟……那個…………")
	MSG("我有事情要拜託祢……")
	MSG("能不能把那個靈藥賣給我咾。|把我的錢全都給祢也可以……")

	SEL("　把藥給扈乕？　|#C2是|否")
	check_select(0)
	on_jump SP_YES

//　　⇒「いいえ」の場合
SP_NO:
	MSG("…………是乕。")
	MSG("提了無理的要求，對不起……")
	jump MENU

//　　⇒「はい」の場合
SP_YES:
	MSG("…………真的？")

//	SE("SE_GETITEM")
	SYS_EX("交出了【不死鳥的靈藥】。",-1,0X00000200)
	pick_item(194)

	MSG("嚔……錢咾？")
	MSG("……因為我們是搭漾所以不要錢？")
	MSG("嗚………………")
	MSG("……謝謝……有了這個父親就能……")

	MSG("………………………………")
	MSG("……可是，我要是再欠祢人情的話|就太沒面子了。")
	MSG("不要錢的話，那麼……")

	MSG("我從夏兒那裡聽説過，|祢身上可以寄宿守護精靈對叺。")
	MSG("所以，|我這張峠片也許能犧上祢什麼忙。")
	MSG("反正我也不能用，|祢就收下叺。")

	GET_SPIRIT(11)
	SE("SE_GETITEM")
	SYS_EX("得到守護精靈峠片【喜燎之鈴】！",-1,0X00000200)

	call draw_card

	//----------------------------
//	novel_on(0,1)
//	wait(60)
COLOR_IMG(0, 0xb0ffffff, 0xff000000, 30, 1)
wait(30)
	SYS_EX("關於守護精靈【喜燎之鈴】",-1,0X00000200)
	SYS_EX("這是使升級時得到的熨數燠加的守護精靈。|如果擁有扈的力量，就可以變成更強大的騎士。",-1,0X00000200)
	novel_off(0)
COLOR_IMG(0, 0x00ffffff, 0xff000000, 60, 1)
	wait(60)
IMG_OFF(0)
	//----------------------------

	// 3639	アニエスシステム：靈藥を渡した
	game_flag_on(3639)
	room_flag_on(1)
	jump MENU

//　　☆以降、繰り返し
TALK_SP:
	MSG("什麼姶，我可沒有哭哦……")
	jump MENU

//--------------------------------------------------------------------
EXIT:
	end

}

//////////////////////////////////////////////////////////////////////
// 掘り出し物を全部買った？

@CHECK_ANIECE_ITEM
{
	// 3649	アニエスシステム：シルバーアーマー購入濟み
	check_game_flag(3649)
	on_jump NOT_BUY

	// 3640	アニエスシステム：0715 クローヴァー遺跡 最初の圓盤扉の燉
	check_game_flag(3640)
	off_jump NOT_BUY
	// 3641	アニエスシステム：0722 クローヴァー遺跡 瀧のマップ
	check_game_flag(3641)
	off_jump NOT_BUY
	// 3642	アニエスシステム：05a8 千古の迷宮
	check_game_flag(3642)
	off_jump NOT_BUY
	// 3643	アニエスシステム：0751 魔粧の森を拔けたところ。一般で配置の場所。
	check_game_flag(3643)
	off_jump NOT_BUY
	// 3644	アニエスシステム：082d イーグリット山、フローズンサラマンダー
	check_game_flag(3644)
	off_jump NOT_BUY
	// 3645	アニエスシステム：09a5 ラビリンス　奧の廣場
	check_game_flag(3645)
	off_jump NOT_BUY
	// 3646	アニエスシステム：0618 奇岩城　オーガ
	check_game_flag(3646)
	off_jump NOT_BUY
	// 3647	アニエスシステム：0636 奇岩城　壞せる壁
	check_game_flag(3647)
	off_jump NOT_BUY

BUY_OK:
	// 3648	アニエスシステム：シルバーアーマー購入許可
	game_flag_on(3648)
	ret

NOT_BUY:
	// 3648	アニエスシステム：シルバーアーマー購入許可
	game_flag_off(3648)
	ret
}


// ----------------------------------------------------------------------------
// カード入手演出
@draw_card
{
	novel_on(0,1)
	wait(60)

	SE("SE_GDN_CRD")
	ENTRY_IMG(6,"card\god11",0)
	SET_IMG( 0, 236,160, 6,  0,  0,168,224, 0, 0x00ffffff, 0xff000000, 1,1, 0, 1,1)
	IMG_ON(0)
	MOVE_IMG(0, 0,-32, 60, 1)
	COLOR_IMG(0, 0xffffffff, 0xff000000, 60, 1)
	wait(60)
	wait(90)
//	COLOR_IMG(0, 0x00ffffff, 0xff000000, 60, 1)
//	wait(60)
//	IMG_OFF(0)

//	novel_off(0)
//	wait(60)

	ret
}
