
// ----------------------------------------------------------------------------
// マップ                                                                    
// ----------------------------------------------------------------------------

DEF("MAP")
RES("INIT")
{

	// カギを持っているなら寶箱消す
	CHECK_KEY(3)
	OFF_SKIP(1)
	HIDE_CHR("tbox")

}


// ----------------------------------------------------------------------------
// 寶箱                                                                        
// ----------------------------------------------------------------------------

DEF("tbox")
RES("INIT")
{
	SET_TREASURE("tbox",1,203,"ITEM")
}

DEF("ITEM")
RES("CATCH")
{
	SE("SE_GETITEM")
	STOP_PC(0)
	SYS("#C2得到異界的鑰匙！")
	KILL_CHR("tbox",0,0,0)
}


// ----------------------------------------------------------------------------
// マップ移動                                                                  
// ----------------------------------------------------------------------------

DEF("09ad_09ac")
RES("EVENT")
{
	ENTRY_MAP("09ac_09ad")
}

