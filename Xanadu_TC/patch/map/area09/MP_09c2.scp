//////////////////////////////////////////////////////////////////////
// ガンダルチュアイベント

DEF("EV_Gandaltua")

RES("EVENT")
{
	// EV C-7 ガンダルチュア
	check_game_flag(3706)
	on_jump EXIT

	// シネスコ時スペクタクルズONFF
	ROOM_FLAG_OFF(254)

	BGM(18, 0, -1)

	CINEMA_ON(0)
	stop_pc(0)
	set_pos("PC",4.82,16.00,-0.04)
	set_deg("PC", 94)

	cross_fade(120)
	permit_script_camera(1)
	set_script_camera(11.67,16.00,-0.29, -15.5,250.0,0.0, 20, 15.0)
	rotate_script_camera(0,30,0, 300, 1)

	//武器もってなければスキップ。
	CHECK_PC_EQUIP(0,-1)
	ON_SKIP(1)
	PC_WEAPON(1,1)

	set_skip_label("SKIP")

//　　祠の中に入って、ゲートの直前マップまで進むとイベント開始。
//　　橋の上に巨漢の男、ガンダルチュアが立っている。

	MSG_EX("#S3#C0壯漢「果然來了姶……」",-1,2)

	wait_camera(0)

//　　身構える主人公。
//　　武器もってなければスキップ。
	CHECK_PC_EQUIP(0,-1)
	ON_SKIP(5)
	scale_script_camera(0.8, 20, 1)
	cross_fade(60)
	wait(60)
	MSG_EX("#S3#C0壯漢「嚔呀，看我熕形這麼巨大，|　　　可不要把我當成魔物姶。」",-1,2)
	MSG_EX("#S3#C0壯漢「就算是這樣也是容易受傷的。」",-1,2)

	WAIT(60)
	SET_MOTION("Gandaltua", "ATTACK1",-1)
	MSG_EX("#S3#C0壯漢「本大爺名叫剛達爾奇。」",-1,2)

	MSG_EX("#S3#C0剛達爾奇「是祢也認識的石頭劍客，|　　　　　熏沃夏克的朋友。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「在這麼危險的地方等著祢是有原因的……」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「其實是有事情拜託祢。」",-1,2)

//　　劍を鞘に收める主人公。

	set_script_camera(11.67,16.00,-0.29, -15.5,270.0,0.0, 15, 15.0)
	cross_fade(60)


	//武器もってなければスキップ。
	CHECK_PC_EQUIP(0,-1)
	ON_SKIP(1)
	PC_WEAPON(0)

	wait(60)
	SET_MOTION("PC","EMPTY23",-1)
	WAIT(100)

	MSG_EX("#S3#C0剛達爾奇「囀囀……祢這麼通情達理，|　　　　　真是犧了我們大忙。」",-1,2)
	wait(40)
	MSG_EX("#S3#C0剛達爾奇「雖然和祢的目的不同，|　　　　　不過我們也是衝著奇岩城來的。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「前面是時間和空間都被扞曲了的地方，|　　　　　被稱作『時之縫隙』。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「如果能滷順利的透過那裡，|　　　　　就應該可以進入奇岩城。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「我們已經弄清楚解除障壁的裝置就在城堡裡面。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「希望祢能滷找到它，|　　　　　並解除障壁。」",-1,2)
	wait(60)

	set_script_camera(6.33,16.00,-0.33, -15.5,0.0,0.0, 12, 15.0)
	move_script_look_at(2,0,0, 600, 1)
	cross_fade(60)

	MSG_EX("#S3#C0剛達爾奇「……不過，|　　　　　要到那裡需要先解決一個大難題。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「在時之縫隙裡關著一個脾氣很壞的魔女。」",-1,2)
	wait(40)
	MSG_EX("#S3#C0剛達爾奇「雖然熏沃夏克先進去了，|　　　　　不過很可能打不過扈。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「如果遇到他的話，|　　　　　祢們最好合力戰熹。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「怎麼樣，我們覺得祢是個有能力的騎士，|　　　　　請一定要犧忙。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「祢一定能犧助我們的……|　　　　　我的直覺告訴我。」",-1,2)

	fade_out(60)
	WAIT(90)


SKIP:
	PC_WEAPON(0,1)

	game_flag_on(3706)
	bgm(-1,0,-1)

	FOCUS_CHR("PC")
	permit_script_camera(0)
	CINEMA_OFF(0)
	fade_in(60)
	wait(60)

	// シネスコ時スペクタクルズONFF
	ROOM_FLAG_ON(254)

EXIT:
	end
}

//////////////////////////////////////////////////////////////////////
// ガンダルチュア

DEF("Gandaltua")

RES("INIT")
{
	// EV C-7c ガンダルチュアとシュトゥルムの會話イベント
	check_game_flag(3725)
	on_jump EXIT

	// EV C-7b ガンダルチュアとの會話後、ランダムマップに飛んだ
	check_game_flag(3724)
	off_jump EXIT

//--------------------------------------------------------------------

	// シネスコ時スペクタクルズONFF
	ROOM_FLAG_OFF(254)

	CINEMA_ON(0)
	stop_pc(0)


	HIDE_CHR("PC")

	stop_camera(0)
	BLUR(0)
	SLOW(0)

	fade_out(0)
	wait(60)

	permit_script_camera(1)
	set_script_camera(12.67,16.00,-0.29, -15.5,270.0,0.0, 12, 15.0)

	set_deg("Gandaltua", 90)

	fade_in(120)
	wait(120)

	set_skip_label("SKIP")

//　　主人公がゲートに入って時の狹間に移動したら、畫面ブラック
//　　アウト。フェードアウト拔けて、再び祠のガンダルチュア。
//　　主人公の去った扉のほうを見つめている。

	SHOW_CHR("Sturm")
	SHOW_CHR("Tiowald")
	SHOW_CHR("Beatrice")
	SHOW_CHR("Avatarlaha")
	set_pos("Sturm",      -2.27,16.00,-1.22)
	set_pos("Tiowald",    -5.09,16.00,-0.31)
	set_pos("Beatrice",   -1.42,16.00,0.42)
	set_pos("Avatarlaha", -5.24,16.00,1.18)
	set_deg("Sturm",      90)
	set_deg("Tiowald",    90)
	set_deg("Beatrice",   90)
	set_deg("Avatarlaha", 90)

	MSG_EX("#S3#C0貝亞特里奇「好像走了……」",-1,2)

	move_script_look_at(-4,1,0, 600, 1)
	rotate_script_camera(10,0,0, 600, 1)

	INIT_WALK_DST("Beatrice")
	set_walk_dst("Beatrice",  4.05,16.00,0.54)

	INIT_WALK_DST("Sturm")
	set_walk_dst("Sturm",  1.71,16.00,-1.27)

	INIT_WALK_DST("Avatarlaha")
	set_walk_dst("Avatarlaha",  0.16,16.00,1.19)

	INIT_WALK_DST("Tiowald")
	set_walk_dst("Tiowald",  -2.42,16.00,-0.34)

	walk_pos("Beatrice",0,0.05)
	walk_pos("Sturm",0,0.05)
	wait(40)
	walk_pos("Avatarlaha",0,0.05)
	walk_pos("Tiowald",0,0.05)

	wait_walk("Beatrice")
	set_deg("Beatrice", 111)
	look_chr("Beatrice","Gandaltua")

	wait_walk("Sturm")
	set_deg("Sturm", 171)

	wait_walk("Avatarlaha")
	set_deg_ex("Avatarlaha", "Sturm")
	look_chr("Avatarlaha","Gandaltua")

	wait(120)
//	wait_camera(0)

	MSG_EX("#S3#C0剛達爾奇「姶姶，要是能澁上就好了。」",-1,2)

//	set_deg_ex("Gandaltua","Tiowald")
	set_deg("Gandaltua" 170)
	wait(5)
	INIT_WALK_DST("Gandaltua")
	set_walk_dst("Gandaltua",  8.39,16.00,-0.27)
	walk_pos("Gandaltua",0,0.03)
	wait_walk("Gandaltua")

	SET_MOTION("Avatarlaha", "ATTACK1",-1)
	MSG_EX("#S3#C0阿巴塔拉哈「和那個洛蕾倏交手，|　　　　　　我們的力量遠遠不滷……」",-1,2)
	MSG_EX("#S3#C0阿巴塔拉哈「只能拜託|　　　　　　他們兩個人了。」",-1,2)

	set_motion("Sturm", "ATTACK1", -1)
	MSG_EX("#S3#C0修特威爾姆「……但是，這個時代的騎士|　　　　　不是已經失去力量被毀滅了乕。」",-1,2)
	MSG_EX("#S3#C0修特威爾姆「真的沒問題乕？」",-1,2)

//	set_deg_ex("Beatrice","Sturm")
	set_deg("Beatrice",190)
	look_chr("Beatrice","Sturm")
//	SET_MOTION("Beatrice", "ATTACK1",-1)

	MSG_EX("#S3#C0貝亞特里奇「我見識了他在遺跡裡與得到王冠之力的魔物的戰熹。」",-1,2)
	MSG_EX("#S3#C0貝亞特里奇「在戰熹中他不斷成長。」",-1,2)
	MSG_EX("#S3#C0貝亞特里奇「雖然聽説是他為了自己能活得長久才戰熹，|　　　　　　不過應該還背負著更重要的事情叺？」",-1,2)
	MSG_EX("#S3#C0貝亞特里奇「雖然不知道那是什麼……」",-1,2)
	MSG_EX("#S3#C0貝亞特里奇「不過那樣才是騎士姶。」",-1,2)
	wait(100)

//	cross_fade(60)
//	set_script_camera(2.56,17.00,0.99, -10.5,250.0,0.0, 10, 15.0)
//	rotate_script_camera(0,-5,0, 2000, 1)

	MSG_EX("#S3#C0提歐巴特「………………」",-1,2)

	set_deg("Avatarlaha", 208)
	look_chr("Avatarlaha","Tiowald")
	wait(40)

	MSG_EX("#S3#C0阿巴塔拉哈「提歐巴特老頭，怎麼了？」",-1,2)

//	set_deg_ex("Tiowald","Avatarlaha")
	wait(20)
	set_deg_ex("Beatrice","Sturm")
	look_chr("Beatrice","Tiowald")

	wait(40)
	look_chr("Tiowald","Avatarlaha")
	MSG_EX("#S3#C0提歐巴特「……有些事情希望大家認清聽好。」",-1,2)
	MSG_EX("#S3#C0提歐巴特「來這裡之前，|　　　　我進行了占星。」",-1,2)
	wait(40)
	MSG_EX("#S3#C0阿巴塔拉哈「哦哦，提歐巴特老頭的占卜，|　　　　　　鎮上的人都説很靈燻的。」",-1,2)
	MSG_EX("#S3#C0阿巴塔拉哈「那麼，占星看到了些什麼？」",-1,2)
	wait(40)
	MSG_EX("#S3#C0提歐巴特「……我看到了他的三顆星星合成了一顆。」",-1,2)

	wait(20)
//	SET_MOTION("Sturm", "ATTACK1",-1)
	set_deg("Sturm", 180)
	look_chr("Sturm","Tiowald")
	wait(20)
	MSG_EX("#S3#C0修特威爾姆「三顆星星……」",-1,2)
	MSG_EX("#S3#C0修特威爾姆「難道是希琉加之星乕？",-1,2)
	wait(40)
	look_chr("Tiowald","Gandaltua")
	MSG_EX("#S3#C0提歐巴特「在這次戰熹中應該就能明白一切了。」",-1,2)

	wait(40)
//	move_script_look_at(1,1,0, 200, 1)

	SET_MOTION("Gandaltua", "ATTACK1",-1)
	MSG_EX("#S3#C0剛達爾奇「這不是全部託付給他了乕。」",-1,2)
	MSG_EX("#S3#C0剛達爾奇「我們和……」",-1,2)
	wait(60)
	scale_script_camera(1.5, 220, 1)
	fade_out(180)

	MSG_EX("#S3#C0剛達爾奇「芙羅蕾特大人的命運。」",-1,2)

	wait_camera(0)

//　　畫面フェードアウト拔けて、時の狹間マップ。
//　　操作フリーに。

	// ランダムマップにつなぐ

SKIP:
	wait(120)

	wait(2)
	SHOW_CHR("PC")
	game_flag_on(3725)

	ENTRY_RANDOM_MAP(0, 5,5, 3,4, "rndmap_0998")

//--------------------------------------------------------------------
EXIT:

	END
}



RES("CLICK")
{

	FOCUS_CHR("Gandaltua")
	SET_NAME("AVATARLAHA", "阿巴塔拉哈")
	SET_MOTION("Gandaltua", "ATTACK1",-1)

//	check_room_flag(0)
//	on_jump TALK1_2

TALK1_1:
	MSG("希望祢能穿過時之縫隙，|從奇岩城漓部將障壁解除。")
	MSG("祢一定能犧助我們……|我有這樣的感覺。")
	room_flag_on(0)
	jump EXIT

////　　以降、繰り返し用メッセージ
//TALK1_2:
//	MSG("ドヴォルザークを助けてやってくれ。")
//	MSG("思うところは色々あるだろうが|ここは目的が同じもの同士、|協力し合おうじゃないか。")
//	MSG("あんたはきっと助けてくれる。|そんな氣がするんだよな。")
	
EXIT:
	SET_MOTION("Gandaltua","STAND",-1)
	END
}
