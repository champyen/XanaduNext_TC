DEF("MAP")

RES("INIT")
{
	// ƒVƒlƒXƒRƒXƒyƒNƒ^ƒNƒ‹ƒYON
	ROOM_FLAG_ON(254)

	// ƒ|[ƒ^ƒ‹θA
	CHECK_GAME_FLAG(4014)
