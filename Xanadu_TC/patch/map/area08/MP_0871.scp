	// SEΔ¶
	SE("SE_WIND2")

	HIDE_CHR("Beatrice")
	HIDE_CHR("Avatarlaha")

	HIDE_CHR("Sturm")

	// EV B-8 ƒC[ƒOƒƒbƒgR(ƒxƒAƒgƒ[ƒ`ƒF‚ΖƒAƒoƒ^[ƒ‰ƒn)
