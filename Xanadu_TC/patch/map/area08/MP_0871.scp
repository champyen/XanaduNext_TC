	// ƒtƒ@ƒCƒAƒNƒƒXƒ^ƒ‹‚π‚Α‚Δ‚Ά‚ι‚©H
	CHECK_ITEM(177,1)
	OFF_JUMP NEXT2

	// o»ƒCƒxƒ“ƒg
	STOP_PC(0)
	CINEMA_ON(0)
	SET_WALK_DST("PC",-0.5,0.375,5.5)
	WALK_POS("PC",0,0.026)
	WAIT_WALK("PC")
	INIT_WALK_DST("PC")
