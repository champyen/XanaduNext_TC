DEF("portal")

RES("EVENT")
{
	INIT_WALK_DST("PC")

	// 05/06/20:‚eƒNƒƒXƒ^ƒ‹‚ΝΕ‰‚Μκ‰ρ‚Ύ‚―‚Ε‚Ά‚Ά–‚Ι‚Θ‚θ‚ά‚µ‚½i‚Πj

	// ω‚Ι‚ ‚―‚Δ‚Ά‚ι‚©H
	CHECK_GAME_FLAG(4014)
