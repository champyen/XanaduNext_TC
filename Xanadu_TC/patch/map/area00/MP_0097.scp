DEF("EV_Gate")

RES("EVENT")
{
	// 4		ƒCƒ“ƒtƒFƒ‹ƒm‚ð“|‚µ‚½‚©H
	check_game_flag(   4)
	off_jump NEXT3
	// 3617	EV B-9b ƒCƒ“ƒtƒFƒ‹ƒm“|‚µ‚½ŒãAƒVƒƒƒ‹‚Æ˜b‚µ‚½
	check_game_flag(3617)
	off_jump EV_CHAR_MOUNTAIN
NEXT3:

	// 3603	EV B-4 ƒgƒŒƒ“ƒgDŒã(ƒhƒ”ƒHƒ‹ƒU[ƒN‚Æ‚Ì˜ð˜b)
	check_game_flag(3603)
	off_jump NEXT4
	// 3623	TK B-4c ƒgƒŒƒ“ƒgDŒãAƒNƒ‰ƒEƒ“‚É‚Â‚¢‚Ä‚ÌƒVƒƒƒ‹‚Ì˜ð˜b
	check_game_flag(3623)
	off_jump EV_INN2
NEXT4:


EXIT:
	end

//-- ‚a-‚X@ƒCƒ“ƒtƒFƒ‹ƒmDŒã‚Ìƒn[ƒŒƒbƒN -----------------------------
EV_CHAR_MOUNTAIN:
	stop_pc(0)
	fade_out(60)
	wait(60)
	reset_camera(0)
	wait(60)

	call CHAR_EVENT_MOUNTAIN
	end

//-- ‚a-‚S‚a ƒgƒŒƒ“ƒgDŒã‚Ìƒn[ƒŒƒbƒN --------------------------------
EV_INN2:
	stop_pc(0)
	fade_out(60)
	wait(60)
	reset_camera(0)
	wait(60)

	call CHAR_EVENT_BOSS1
	end
}


