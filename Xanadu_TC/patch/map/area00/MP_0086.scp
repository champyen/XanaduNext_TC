RES("HIT")
{
	GAME_FLAG_ON(3302)

	// EV C-3 ŠïŠâéoŒ»
	game_flag_on(3702)

	STOP_PC(0)
	CINEMA_ON(0)
	pick_item(191)
	stop_bgm(1,1000)
	STOP_SE(0)

	CROSS_FADE(30)	
	PERMIT_SCRIPT_CAMERA(1)
	SET_SCRIPT_CAMERA( 70,10,0,  -30,-60,0, 65, 60 )
	set_skip_label("SKIP")

	//Ž€–SƒGƒtƒFƒNƒgá¢“®
	ATTACH_EFC("EFC_00BREAKEYE","obj","CTR")
	SE("SE_EVENT_18")
