	WAIT(60)
	//ƒtƒ‰ƒbƒVƒ…ƒJƒƒ‰‚Q
	FADE_OUT_EX(10, 0, "0xffffffff", 1)
	WAIT(40)
	FADE_IN_EX(10, 0, "0xffffffff", 1)
	BLUR(10)
	CROSS_FADE(10)
	SET_SCRIPT_CAMERA( 100,6,0,  10,-90,0, 80, 50 )
	SCALE_SCRIPT_CAMERA( 1.1,500, 1)
	SE("SE_EVENT_20")
	WAIT(100)
	KILL_CHR("eye",0,1,420)
	KILL_CHR("kagi",0,1,420)

	//ƒtƒ‰ƒbƒVƒ…ƒ`ƒJƒ`ƒJƒ`ƒJEEEII
	FADE_OUT_EX(5, 0, "0xffffffff", 1)
	WAIT(5)
	FADE_IN_EX(4, 0, "0xffffffff", 1)
	WAIT(4)
	FADE_OUT_EX(5, 0, "0xffffffff", 1)
	WAIT(5)
	FADE_IN_EX(4, 0, "0xffffffff", 1)
	WAIT(4)
	WAIT(120)

	//ƒzƒƒCƒgƒAƒEƒgBƒ€[ƒr[‚ÖŒq‚°‚é
	FADE_OUT(80)
	BLUR(100)
	WAIT(200)
	//…‚È‚µƒ}ƒbƒv‚Æ‡‚°‘Ö‚¦
	LOAD_MAP("MP_008e")
	CAMERA_OFF("”j–‚–î")
	BLUR(0)

	FOCUS_CHR("PC")
	PERMIT_SCRIPT_CAMERA(0)
	WAIT(80)
	
		play_movie("system\ins01.dat", 21)
	
	//’Êí‚É–ß‚·
	BGM( 7, 0, 1000)

	CINEMA_OFF(0)
	FADE_IN(90)
	WAIT(90)
	END


SKIP:
	// BGM
	BGM( 7, 0, 1000)

	//‚¢‚ë‚¢‚ë‚È™|—
	STOP_SE(0)



	BLUR(0)
	DELETE_EFC("obj")
	KILL_CHR("eye",0,1,1)
	KILL_CHR("kagi",0,1,1)
	LOAD_MAP("MP_008e")
	CAMERA_OFF("”j–‚–î")
	WAIT(80)

	CINEMA_OFF(0)
	FOCUS_CHR("PC")
	permit_script_camera(0)
	FADE_IN(90)
	WAIT(90)

EXIT:
	END
}



