next:

	// éÄê_èoÇ≥Ç»Ç¢
	PERMIT_DEATH(0)
	// èoåªù…Åiç≈è¨ÅAç≈ëÂÅj
	SET_MAX_MONSTER(1,1)
	// ÇæÇÒÇæÇÒã≠Ç≠Ç»ÇÈÅièoåªâÒù…ÌPÅ{ÅAñÈÇÕÇ≥ÇÁÇ…Å{)
	SET_MONSTER_LVUP(1,5)
	// èoåªÉÇÉìÉXÉ^Å[ÅiÉÇÉìÉXÉ^Å[î‘ÂjÅAÉåÉxÉãÅAùÍÇPÇQÇRÇSÅAñÈÇPÇQÇRÇSÅAèoåªämó¶ÅAñºëOÅj
	// ÉfÉXÅiè‡éÁÇËÅj
	ENTRY_MONSTER(316,  8,"1234","1234",100,"")
	// èoåªàÍéûí‚é~
	PAUSE_MONSTER(1,0)

	// ÉJÉMê›íË
	CHECK_GAME_FLAG(1554)
	ON_SKIP(2)
	KAGI("d1554",1)
	SKIP(1)
	INIT_SWITCH_ON("d1554")

	// íÜÉ{ÉXèoåªÇÃëOÉtÉä
	CHECK_GAME_FLAG(518)
	ON_SKIP 1
	stop_bgm(0,2000)
}

RES("EXIT")
{
	// íÜÉ{ÉXÇ≈è¡Ç¶ÇΩÇaÇfÇlõîçÙ
	CHECK_GAME_FLAG(518)
	ON_SKIP 1
	BGM(-1, 0, -1)
}


// É{ÉXì|ÇµÇΩÇº--------------------------------------------------------------
RES("WIN")
{
	CHECK_GAME_FLAG(518)
	ON_JUMP next

	SE("SE_STOPPER")
	CINEMA_ON(0)
	FOCUS_CHR("null2")
	EFC("EFC_ADD_TREASURE",7.5,0,-1)
	SHOW_CHR("tbox2")
	WAIT(60)
	CINEMA_OFF(0)
//		STOP_PC(0)
//		WAIT(60)
//		SE("SE_STOPPER")
//		CINEMA_ON(0)
//		FOCUS_CHR("stop")
//		SWITCH_ON("stop")
//		WAIT(90)
//		CINEMA_OFF(0)

		bgm(-1,0,-1)

	GAME_FLAG_ON(518)

next:
}

