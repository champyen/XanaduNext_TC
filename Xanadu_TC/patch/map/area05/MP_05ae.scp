DEF("tbox2")
RES("INIT")
{
	//É{ÉXì|ÇµÇΩÇ©Ç«Ç§Ç©
	CHECK_GAME_FLAG(518)
	OFF_JUMP next

	//äJÇØÇΩÇ©Ç«Ç§Ç©
	CHECK_GAME_FLAG(521)
	OFF_SKIP(1)

	INIT_SWITCH_ON("tbox2")
	END

next:
	HIDE_CHR("tbox2")
}

RES("CLICK")
{
	CINEMA_ON(0)
	STOP_PC(0)
	FOCUS_CHR("tbox2")

	SWITCH_ON("tbox2")
	POP_ITEM_ICON("tbox2", 25, 7.5,0,-1, 1,80,0)
	WAIT(140)

	CHECK_MAX_ITEM(0)
	ON_JUMP EXIT

	DEL_ITEM_ICON("tbox2")
	ATTACH_EFC("EFC_99ITEM_GET","tbox2","POS")

	SYS_EX("ìæìûÅyóãñ¬í∑ôòÅzÅI",-1,0X00000200)

	GET_ITEM(25,1)
	GAME_FLAG_ON(521)
	FOCUS_CHR("PC")
	CINEMA_OFF(0)
	END

EXIT:
	SE("SE_ERROR")
	DEL_ITEM_ICON("tbox2")
	SYS_EX("ù\ïsìÆçXëΩçsóõóπÅB",-1,0X00000200)
	SWITCH_OFF("tbox2")
	FOCUS_CHR("PC")
	CINEMA_OFF(0)

}
