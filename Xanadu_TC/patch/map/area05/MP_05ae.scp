	CHECK_GAME_FLAG(518)
	OFF_JUMP next
	// É}É~Å[
	put_monster("m00",012,10,0,0,0)
	put_monster("m01",012,10,0,0,1)
	put_monster("m02",012,10,0,0,2)
//	put_monster("m03",012,10,0,0,3)
